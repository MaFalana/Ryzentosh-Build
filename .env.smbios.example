# SMBIOS Values Template
# Copy this file to .env.smbios and fill in your values
# Generate with: macserial -m iMacPro1,1 -g -n 1
# Or use GenSMBIOS tool

SMBIOS_MODEL=iMacPro1,1
SMBIOS_SERIAL=XXXXXXXXXXXX
SMBIOS_MLB=XXXXXXXXXXXXXXXXX
SMBIOS_UUID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
SMBIOS_ROM=XXXXXXXX
